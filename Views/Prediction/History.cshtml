@using Danciu_Lavinia_Lab4.Models
@model IEnumerable<PredictionHistory>

@{
    ViewData["Title"] = "History";
}
@*value = ce ajunge în controller
selected = ce vezi selectat pe ecran
textul (Card / Cash) = DOAR afișare*@

<h2>Istoric predicții</h2>
<form method="get" asp-action="History" class="row g-3 mb-3">
    <div class="col-md-3">
        <label class="form-label">Tip plată</label>
        <select name="paymentType" class="form-select">
            <option value="">Toate</option>
            <option value="CRD" selected="@(ViewBag.CurrentPaymentType ==
                                                                      "CRD")">Card</option>
            <option value="CSH" selected="@(ViewBag.CurrentPaymentType ==
                                                                      "CSH")">Cash</option>
            <option value="OTHER" selected="@(ViewBag.CurrentPaymentType ==
                                                                        "OTHER")">Altele</option>
        </select>
    </div>

    <div class="col-md-2">
        <label class="form-label">Preț minim</label>
        <input type="number" step="0.01" name="minPrice"
               value="@(ViewBag.CurrentMinPrice ?? "")"
               class="form-control" />
    </div>

    <div class="col-md-2">
        <label class="form-label">Preț maxim</label>
        <input type="number" step="0.01" name="maxPrice"
               value="@(ViewBag.CurrentMaxPrice ?? "")"
               class="form-control" />
    </div>
    @*FORMULARUL PT DATA *@

    <div class="col-md-2">
    <label class="form-label">Data start</label>
    <input type="date" name="startDate"
           value="@(ViewBag.CurrentStartDate ?? "")"
           class="form-control" />
    </div>

    <div class="col-md-2">
        <label class="form-label">Data end</label>
        <input type="date" name="endDate"
               value="@(ViewBag.CurrentEndDate ?? "")"
               class="form-control" />
    </div>

    <div class="col-md-2 align-self-end">
        <button type="submit" class="btn btn-primary">Filtrează</button>
    </div>
</form>




<table class="table table-striped">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.CreatedAt)

                <a asp-action="History"
                   asp-route-paymentType="@ViewBag.CurrentPaymentType"
                   asp-route-minPrice="@ViewBag.CurrentMinPrice"
                   asp-route-maxPrice="@ViewBag.CurrentMaxPrice"
                   asp-route-startDate="@ViewBag.CurrentStartDate"
                   asp-route-endDate="@ViewBag.CurrentEndDate"
                   asp-route-sortOrder="date_asc">↑</a>

                <a asp-action="History"
                   asp-route-paymentType="@ViewBag.CurrentPaymentType"
                   asp-route-minPrice="@ViewBag.CurrentMinPrice"
                   asp-route-maxPrice="@ViewBag.CurrentMaxPrice"
                   asp-route-startDate="@ViewBag.CurrentStartDate"
                   asp-route-endDate="@ViewBag.CurrentEndDate"
                   asp-route-sortOrder="date_desc">↓</a>
            </th>
            <th>@Html.DisplayNameFor(model => model.PassengerCount)</th>
            <th>@Html.DisplayNameFor(model => model.TripDistance)</th>
            <th>@Html.DisplayNameFor(model => model.TripTimeInSecs)</th>
            <th>@Html.DisplayNameFor(model => model.PaymentType)</th>
            <th>
                @Html.DisplayNameFor(model => model.PredictedPrice)
                <a asp-action="History"
                   asp-route-paymentType="@ViewBag.CurrentPaymentType"
                   asp-route-minPrice="@ViewBag.CurrentMinPrice"
                   asp-route-maxPrice="@ViewBag.CurrentMaxPrice"
                   asp-route-sortOrder="price_asc">↑</a>
                <a asp-action="History"
                   asp-route-paymentType="@ViewBag.CurrentPaymentType"
                   asp-route-minPrice="@ViewBag.CurrentMinPrice"
                   asp-route-maxPrice="@ViewBag.CurrentMaxPrice"
                   asp-route-sortOrder="price_desc">↓</a>
            </th>
         
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.CreatedAt)</td>
                <td>@Html.DisplayFor(modelItem => item.PassengerCount)</td>
                <td>@Html.DisplayFor(modelItem => item.TripDistance)</td>
                <td>@Html.DisplayFor(modelItem => item.TripTimeInSecs)</td>
                <td>@Html.DisplayFor(modelItem => item.PaymentType)</td>
                <td>@Html.DisplayFor(modelItem => item.PredictedPrice)</td>
               
            </tr>
        }
    </tbody>

</table>